# Copy to .env at the repository root. Never commit the real file.
AKASH_ENV=prod
AKASH_CONTACT_EMAIL=you@example.org
# Registry paths are inside the container (the models directory is mounted at /models).
AKASH_TRANSIT_MODEL=
AKASH_ANOMALY_REFERENCE=
# Optional LLM for the research agent. Leave empty to use the deterministic answerer.
AKASH_LLM_BASE_URL=https://openrouter.ai/api/v1
AKASH_LLM_API_KEY=
AKASH_LLM_MODEL=
# Same-origin through nginx, so CORS stays empty.
AKASH_API_CORS_ORIGINS=
